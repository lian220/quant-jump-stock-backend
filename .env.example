# ============================================
# Slack Configuration
# ============================================
# Slack Webhook URLs for different notification types
SLACK_WEBHOOK_URL_TRADING=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_URL_ANALYSIS=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_URL_SCHEDULER=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack Bot Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack Configuration
SLACK_ENABLED=true
SLACK_CHANNEL=your-channel-id

# ============================================
# Database Configuration
# ============================================
# DB 설정은 .env.db.local / .env.db.prod 로 분리됨
# 로컬: .env.db.local (Docker PostgreSQL + MongoDB)
# 운영: .env.db.prod (Supabase + MongoDB Atlas)

# ============================================
# Pub/Sub Configuration (Local Development)
# ============================================
# 로컬: Pub/Sub 에뮬레이터 사용 (docker-compose.yml에서 자동 설정)
PUBSUB_EMULATOR_HOST=pubsub-emulator:8681
PUBSUB_PROJECT_ID=quantiq-local

# ============================================
# KIS API Configuration
# ============================================
# ⚠️ KIS 계정 정보는 사용자별로 DB에서 관리됩니다
# user_kis_accounts 테이블에서 조회
# API를 통해 등록: POST /api/v1/users/{userId}/kis-account
#
# 테스트용 기본값 (docker-compose.yml에서 사용)
KIS_APP_KEY=test_app_key
KIS_APP_SECRET=test_app_secret

# ============================================
# External APIs
# ============================================
# FRED (Federal Reserve Economic Data) API Key
# Get your free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Alpha Vantage API Keys (Multiple for rotation)
# Get free API keys at: https://www.alphavantage.co/support/#api-key
# Free tier: 25 calls/day, 5 calls/min per key
# Add multiple keys (up to 5) for rotation to increase daily limit
ALPHA_VANTAGE_API_KEY_1=your_alpha_vantage_key_1_here
ALPHA_VANTAGE_API_KEY_2=
ALPHA_VANTAGE_API_KEY_3=
ALPHA_VANTAGE_API_KEY_4=
ALPHA_VANTAGE_API_KEY_5=

# ============================================
# Vertex AI Configuration
# ============================================
# Vertex AI 기능 활성화 여부
VERTEX_AI_ENABLED=false

# Vertex AI 전용 인증 파일 경로 (Docker 컨테이너 내부 경로)
# Pub/Sub는 ADC(VM Service Account) 자동 인증
VERTEX_AI_CREDENTIALS_PATH=/app/credentials/vertex-ai-key.json

# Vertex AI 프로젝트 설정 (arboreal-path)
VERTEX_AI_PROJECT_ID=your-vertex-ai-project-id
VERTEX_AI_REGION=us-central1

# Pub/Sub 프로젝트 (인프라 프로젝트: focal-limiter, Vertex AI와 다름)
PUBSUB_PROJECT_ID=your-infra-project-id

# ============================================
# Application Configuration
# ============================================
# Spring Profile (local, dev, prod)
SPRING_PROFILES_ACTIVE=local

# Database Dual Write Configuration
DB_DUAL_WRITE=true
DB_READ_SOURCE=rdb

# Migration Configuration
RUN_MIGRATION=true

# JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_GENERATE_DDL=false
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# ============================================
# Server Configuration
# ============================================
SERVER_PORT=10010
DATA_ENGINE_PORT=8000

# ============================================
# Logging Configuration
# ============================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_QUANTJUMPSTOCK=DEBUG

# ============================================
# Security Configuration
# ============================================
# JWT Secret Key (Generate a strong random key for production)
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=86400000

# ============================================
# Notes
# ============================================
# 1. Copy this file to .env.local and fill in your actual values
# 2. Never commit .env.local to version control
# 3. For Docker deployment, create symlink: ln -sf quant-jump-stock-backend/.env.local .env
# 4. Get FRED API key (free): https://fred.stlouisfed.org/
# 5. Get KIS API credentials: https://www.koreainvestment.com/
