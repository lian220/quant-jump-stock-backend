# GitHub Actions 배포용 환경 변수
# 이 파일을 .env.github로 복사하고 실제 값을 입력하세요

# GCP 인증
GCP_PROJECT_ID=your-gcp-project-id
GCP_SA_KEY=your-service-account-json-key

# VM 접속 정보
GCE_HOST=your-vm-ip-address
GCE_USERNAME=deploy
GCE_SSH_PRIVATE_KEY=your-ssh-private-key

# Secret Manager 사용 (환경 변수는 Secret Manager에서 관리)
# 배포 시 자동으로 qjs-env-common, qjs-env-prod를 다운로드
