# ============================================================
# GraalVM Native Image - Production
# ============================================================
# 빌드: CI에서 nativeCompile → 바이너리를 COPY
# 런타임: distroless 기반, non-root, ~150-250MB RSS
# ============================================================

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser && useradd -r -g appuser -d /app appuser

WORKDIR /app

COPY build/native/nativeCompile/quant-jump-stock-core app
COPY entrypoint.sh entrypoint.sh
RUN chmod +x app entrypoint.sh && chown appuser:appuser app entrypoint.sh

USER appuser

# Cloud Run: PORT 환경변수 자동 주입 (기본 8080)
# VM: docker-compose env_file 로 SERVER_PORT 주입
ENV PORT=8080
ENV TZ=Asia/Seoul
EXPOSE 8080

# entrypoint.sh: Cloud Run Secret Manager 파일 → 환경변수 로드 후 앱 실행
ENTRYPOINT ["./entrypoint.sh"]
